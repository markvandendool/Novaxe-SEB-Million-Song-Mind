// In midi.service.ts\
optimizeLatency(): void \{\
  // Use smaller buffer sizes for lower latency\
  this.audioContext.bufferSize = 128; // Minimum safe size\
  \
  // Process MIDI outside Angular zone\
  this.ngZone.runOutsideAngular(() => \{\
    this.midiInput$.pipe(\
      // Immediate processing, no debouncing\
      tap(event => this.processMidiEvent(event))\
    ).subscribe();\
  \});\
  \
  // Use high-resolution timestamps\
  this.performanceNow = performance.now.bind(performance);\
\}\
\
