getRomanNumeral(chord: Chord, key: string): string \{\
  // Check for secondary dominants first\
  if (this.isSecondaryDominant(chord, key)) \{\
    const target = this.getSecondaryTarget(chord, key);\
    return `V7/$\{target\}`; // Return as secondary dominant\
  \}\
  \
  // Standard diatonic analysis\
  return this.getDiatonicRomanNumeral(chord, key);\
\}\
