class SpotifyClient:
    """Handles Spotify API interactions with async support."""
    def __init__(self, config: Config):
        self.config = config
        self.session = None
        self.token = None
        self.token_expiry = 0

    async def get_token(self) -> str:
        """Get or refresh Spotify API token."""
        if self.token and time.time() < self.token_expiry:
            return self.token
        auth_str = f"{self.config.spotify_client_id}:{self.config.spotify_client_secret}"
        auth_b64 = base64.b64encode(auth_str.encode()).decode()
        headers = {"Authorization": f"Basic {auth_b64}", "Content-Type": "application/x-www-form-urlencoded"}
        data = {"grant_type": "client_credentials"}
        async with aiohttp.ClientSession() as session:
            async with session.post("https://accounts.spotify.com/api/token", headers=headers, data=data) as resp:
                if resp.status != 200:
                    logger.error(f"Failed to get Spotify token: {resp.status}")
                    raise aiohttp.ClientError
                data = await resp.json()
                self.token = data["access_token"]
                self.token_expiry = time.time() + data["expires_in"] - 60
                return self.token

    async def batch_get_metadata(self, df: pd.DataFrame) -> pd.DataFrame:
        """Enrich DataFrame with Spotify metadata."""
        async with aiohttp.ClientSession() as self.session:
            self.token = await self.get_token()
            artist_ids = df['spotify_artist_id'].dropna().unique().tolist()
            track_ids = df['spotify_song_id'].dropna().unique().tolist()
            artists = await self.batch_get_artists(artist_ids)
            tracks = await self.batch_get_tracks(track_ids)
            df['artist_name'] = df['spotify_artist_id'].map(lambda x: artists.get(x, (x, x))[0] if pd.notna(x) else x)
            df['artist_url'] = df['spotify_artist_id'].map(lambda x: artists.get(x, (x, f"https://open.spotify.com/artist/{x}"))[1] if pd.notna(x) else x)
            df['song_name'] = df['spotify_song_id'].map(lambda x: tracks.get(x, (x, x))[0] if pd.notna(x) else x)
            df['song_url'] = df['spotify_song_id'].map(lambda x: tracks.get(x, (x, f"https://open.spotify.com/track/{x}"))[1] if pd.notna(x) else x)
            return df

    async def batch_get_artists(self, artist_ids: List[str]) -> Dict[str, Tuple[str, str]]:
        """Batch fetch artist metadata with caching."""
        results = {}
        cache = self._load_cache()
        to_fetch = [aid for aid in artist_ids if aid not in cache]
        for i in range(0, len(to_fetch), self.config.batch_size):
            batch = to_fetch[i:i + self.config.batch_size]
            url = f"https://api.spotify.com/v1/artists?ids={','.join(batch)}"
            headers = {"Authorization": f"Bearer {self.token}"}
            for attempt in range(self.config.max_retries):
                try:
                    async with self.session.get(url, headers=headers, timeout=self.config.api_timeout) as resp:
                        if resp.status != 200:
                            logger.warning(f"Failed to fetch artists {batch}: {resp.status}")
                            break
                        data = await resp.json()
                        for artist in data.get("artists", []):
                            if artist:
                                results[artist["id"]] = (artist["name"], f"https://open.spotify.com/artist/{artist['id']}")
                                cache[artist["id"]] = results[artist["id"]]
                            else:
                                logger.info(f"Artist ID not found: {batch}")
                    break
                except (aiohttp.ClientError, asyncio.TimeoutError) as e:
                    if attempt + 1 == self.config.max_retries:
                        logger.error(f"Failed to fetch artists {batch} after retries: {e}")
                    await asyncio.sleep(2 ** attempt)
        self._save_cache(cache)
        results.update({k: v for k, v in cache.items() if k in artist_ids})
        return results

    async def batch_get_tracks(self, track_ids: List[str]) -> Dict[str, Tuple[str, str]]:
        """Batch fetch track metadata with caching."""
        results = {}
        cache = self._load_cache()
        to_fetch = [tid for tid in track_ids if tid not in cache]
        for i in range(0, len(to_fetch), self.config.batch_size):
            batch = to_fetch[i:i + self.config.batch_size]
            url = f"https://api.spotify.com/v1/tracks?ids={','.join(batch)}"
            headers = {"Authorization": f"Bearer {self.token}"}
            for attempt in range(self.config.max_retries):
                try:
                    async with self.session.get(url, headers=headers, timeout=self.config.api_timeout) as resp:
                        if resp.status != 200:
                            logger.warning(f"Failed to fetch tracks {batch}: {resp.status}")
                            break
                        data = await resp.json()
                        for track in data.get("tracks", []):
                            if track:
                                results[track["id"]] = (track["name"], f"https://open.spotify.com/track/{track['id']}")
                                cache[track["id"]] = results[track["id"]]
                            else:
                                logger.info(f"Track ID not found: {batch}")
                    break
                except (aiohttp.ClientError, asyncio.TimeoutError) as e:
                    if attempt + 1 == self.config.max_retries:
                        logger.error(f"Failed to fetch tracks {batch} after retries: {e}")
                    await asyncio.sleep(2 ** attempt)
        self._save_cache(cache)
        results.update({k: v for k, v in cache.items() if k in track_ids})
        return results

    def _load_cache(self) -> Dict[str, Tuple[str, str]]:
        """Load Spotify cache from file."""
        try:
            with open(self.config.cache_file, 'r') as f:
                return json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            return {}

    def _save_cache(self, cache: Dict[str, Tuple[str, str]]) -> None:
        """Save Spotify cache to file."""
        with open(self.config.cache_file, 'w') as f:
            json.dump(cache, f)

