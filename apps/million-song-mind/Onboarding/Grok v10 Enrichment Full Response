class MusicTheoryEngine:
    """Advanced music theory analysis engine for key detection and harmonic analysis."""
    CHROMATIC_NOTES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B']
    NOTE_TO_INDEX = {note: idx for idx, note in enumerate(CHROMATIC_NOTES)}
    MAJOR_DIATONIC = {0: 'I', 2: 'ii', 4: 'iii', 5: 'IV', 7: 'V', 9: 'vi', 11: 'vii°'}
    MINOR_DIATONIC = {0: 'i', 2: 'iiø', 3: 'bIII', 5: 'iv', 7: 'v', 8: 'bVI', 10: 'bVII'}
    CHORD_QUALITIES = {
        'maj': {'intervals': [0, 4, 7], 'symbol': '', 'roman': 'I'},
        'min': {'intervals': [0, 3, 7], 'symbol': 'm', 'roman': 'i'},
        'dim': {'intervals': [0, 3, 6], 'symbol': '°', 'roman': '°'},
        'aug': {'intervals': [0, 4, 8], 'symbol': '+', 'roman': '+'},
        'maj7': {'intervals': [0, 4, 7, 11], 'symbol': 'maj7', 'roman': 'I7'},
        'min7': {'intervals': [0, 3, 7, 10], 'symbol': 'm7', 'roman': 'i7'},
        'dom7': {'intervals': [0, 4, 7, 10], 'symbol': '7', 'roman': '7'},
        'dim7': {'intervals': [0, 3, 6, 9], 'symbol': '°7', 'roman': '°7'},
        'min7b5': {'intervals': [0, 3, 6, 10], 'symbol': 'ø7', 'roman': 'ø7'},
        'maj9': {'intervals': [0, 4, 7, 11, 14], 'symbol': 'maj9', 'roman': 'I9'},
        'min9': {'intervals': [0, 3, 7, 10, 14], 'symbol': 'm9', 'roman': 'i9'},
        'dom9': {'intervals': [0, 4, 7, 10, 14], 'symbol': '9', 'roman': '9'},
        'dom7b9': {'intervals': [0, 4, 7, 10, 13], 'symbol': '7b9', 'roman': '7b9'},
        'sus2': {'intervals': [0, 2, 7], 'symbol': 'sus2', 'roman': 'sus2'},
        'sus4': {'intervals': [0, 5, 7], 'symbol': 'sus4', 'roman': 'sus4'},
        'no3d': {'intervals': [0, 7], 'symbol': 'no3d', 'roman': ''}
    }

    @staticmethod
    def parse_chord_advanced(chord_str: str) -> Optional[Dict[str, Any]]:
        """Parse chords with support for extensions and edge cases."""
        if not chord_str or not isinstance(chord_str, str):
            return None
        pattern = r'^([A-G][b#]?)' \
                  r'(maj|min|dim|aug|m|°|\+|no3d)?' \
                  r'(\d+)?' \
                  r'([b#]\d+|add\d+|sus[24]|alt)?' \
                  r'(/([A-G][b#]?))?$'
        match = re.match(pattern, chord_str.strip())
        if not match:
            return None
        root, quality, extension, alteration, _, bass = match.groups()
        root = root.replace('b', '#') if 'b' in root else root
        bass = bass.replace('b', '#') if bass and 'b' in bass else bass
        quality_map = {'maj': 'maj', 'min': 'min', 'm': 'min', 'dim': 'dim', '°': 'dim', 'aug': 'aug', '+': 'aug', 'no3d': 'no3d'}
        base_quality = quality_map.get(quality, 'maj')
        chord_type = base_quality
        if extension:
            chord_type += extension
        if alteration:
            chord_type += alteration
        if chord_type not in MusicTheoryEngine.CHORD_QUALITIES:
            chord_type = base_quality
        return {
            'root': root,
            'quality': chord_type,
            'bass': bass,
            'intervals': MusicTheoryEngine.CHORD_QUALITIES.get(chord_type, {'intervals': [0, 4, 7]})['intervals'],
            'chord_str': chord_str
        }

    @staticmethod
    def detect_key(chord_sequence: List[str]) -> Tuple[str, bool, float]:
        """Detect key using Krumhansl-Schmuckler algorithm."""
        if not chord_sequence:
            return 'C', True, 0.0
        pitch_classes = np.zeros(12)
        for chord_str in chord_sequence:
            if chord_str.startswith('<'):
                continue
            parsed = MusicTheoryEngine.parse_chord_advanced(chord_str)
            if parsed:
                root_idx = MusicTheoryEngine.NOTE_TO_INDEX[parsed['root']]
                pitch_classes[root_idx] += 1
                for interval in parsed['intervals']:
                    pitch_classes[(root_idx + interval) % 12] += 0.5
        if pitch_classes.sum() > 0:
            pitch_classes /= pitch_classes.sum()
        major_profile = np.array([6.35, 2.23, 3.48, 2.33, 4.38, 4.09, 2.52, 5.19, 2.39, 3.66, 2.29, 2.88])
        minor_profile = np.array([6.33, 2.68, 3.52, 5.38, 2.60, 3.53, 2.54, 4.75, 3.98, 2.69, 3.34, 3.17])
        key_scores = []
        for tonic in range(12):
            major_corr = np.corrcoef(pitch_classes, np.roll(major_profile, tonic))[0, 1] if pitch_classes.sum() > 0 else 0
            minor_corr = np.corrcoef(pitch_classes, np.roll(minor_profile, tonic))[0, 1] if pitch_classes.sum() > 0 else 0
            key_scores.append(('major', tonic, major_corr))
            key_scores.append(('minor', tonic, minor_corr))
        best_mode, best_tonic, best_score = max(key_scores, key=lambda x: x[2])
        return MusicTheoryEngine.CHROMATIC_NOTES[best_tonic], best_mode == 'major', float(best_score)

    @staticmethod
    def assign_roman_numerals(chord_sequence: List[str], key: str, is_major: bool) -> List[str]:
        """Assign Roman numerals to chord sequence (sync for simplicity)."""
        romans = []
        key_idx = MusicTheoryEngine.NOTE_TO_INDEX[key]
        scale_degrees = MusicTheoryEngine.MAJOR_DIATONIC if is_major else MusicTheoryEngine.MINOR_DIATONIC
        for chord_str in chord_sequence:
            if chord_str.startswith('<'):
                romans.append(chord_str)
                continue
            parsed = MusicTheoryEngine.parse_chord_advanced(chord_str)
            if not parsed:
                romans.append('?')
                continue
            root_idx = MusicTheoryEngine.NOTE_TO_INDEX[parsed['root']]
            degree = (root_idx - key_idx) % 12
            quality = parsed['quality']
            roman = scale_degrees.get(degree)
            if not roman:
                if quality in ['dom7', 'dom9', '7', '9', '7b9']:
                    target_degree = (degree + 5) % 12
                    target_idx = (key_idx + target_degree) % 12
                    target_note = MusicTheoryEngine.CHROMATIC_NOTES[target_idx]
                    roman = f"V7/{target_note}" if is_major else f"v7/{target_note}"
                else:
                    roman = f"b{degree + 1}" if degree > 6 else f"#{degree + 1}"
            if quality in ['min', 'min7', 'min9'] and not roman.startswith(('V', 'b', '#')):
                roman = roman.lower()
            elif quality in ['dim', 'dim7']:
                roman += '°'
            elif quality in ['aug']:
                roman += '+'
            elif quality in ['sus2', 'sus4']:
                roman += quality
            elif quality in ['dom7', '7', 'dom9', '9', '7b9']:
                roman += quality.replace('dom', '')
            if parsed['bass'] and parsed['bass'] != parsed['root']:
                bass_idx = MusicTheoryEngine.NOTE_TO_INDEX[parsed['bass']]
                bass_degree = (bass_idx - root_idx) % 12
                if bass_degree in [4, 7]:
                    roman += f"/{'6' if bass_degree == 4 else '64'}"
                else:
                    roman += f"/{parsed['bass']}"
            romans.append(roman)
        return romans

    @staticmethod
    def generate_harmonic_fingerprint(chord_sequence: List[str], key: str) -> str:
        """Generate HUV-based harmonic fingerprint."""
        huv_vectors = []
        for chord_str in chord_sequence:
            if chord_str.startswith('<'):
                huv_vectors.append(chord_str)
                continue
            parsed = MusicTheoryEngine.parse_chord_advanced(chord_str)
            if parsed:
                vector = np.zeros(12)
                root_idx = MusicTheoryEngine.NOTE_TO_INDEX[parsed['root']]
                vector[root_idx] = 1.0
                for interval in parsed['intervals']:
                    vector[(root_idx + interval) % 12] += 0.5
                vector /= vector.sum()  # Normalize to sum=1
                huv_vectors.append(','.join(f"{x:.2f}" for x in vector))
            else:
                huv_vectors.append('0.08,0.08,0.08,0.08,0.08,0.08,0.08,0.08,0.08,0.08,0.08,0.08')
        return '|'.join(huv_vectors)

