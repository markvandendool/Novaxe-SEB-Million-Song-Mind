# Music theory constants
CHROMATIC_NOTES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B']
NOTE_TO_INDEX = {note: idx for idx, note in enumerate(CHROMATIC_NOTES)}
MAJOR_DIATONIC_DEGREES = [0, 2, 4, 5, 7, 9, 11]  # I, ii, iii, IV, V, vi, vii°

def get_spotify_token():
    """Authenticate with Spotify API and return access token."""
    creds = f"{CLIENT_ID}:{CLIENT_SECRET}"
    encoded = base64.b64encode(creds.encode()).decode()
    headers = {"Authorization": f"Basic {encoded}", "Content-Type": "application/x-www-form-urlencoded"}
    data = {"grant_type": "client_credentials"}
    r = requests.post("https://accounts.spotify.com/api/token", headers=headers, data=data)
    r.raise_for_status()
    return r.json()["access_token"]

def batch_get_artists(artist_ids, token, cache_conn):
    """Fetch artist names and URLs in batches, with caching."""
    c = cache_conn.cursor()
    c.execute('CREATE TABLE IF NOT EXISTS artist_cache (id TEXT PRIMARY KEY, name TEXT, url TEXT)')
    c.execute('SELECT id, name, url FROM artist_cache WHERE id IN ({})'.format(','.join('?' * len(artist_ids))), artist_ids)
    cached = {row[0]: (row[1], row[2]) for row in c.fetchall()}
    
    to_fetch = [aid for aid in artist_ids if aid not in cached]
    results = {}
    if to_fetch:
        for i in range(0, len(to_fetch), 50):
            batch = to_fetch[i:i+50]
            url = f"https://api.spotify.com/v1/artists?ids={','.join(batch)}"
            headers = {"Authorization": f"Bearer {token}"}
            r = requests.get(url, headers=headers)
            if r.status_code == 200:
                for artist in r.json().get("artists", []):
                    if artist:
                        name = artist.get("name")
                        url = artist.get("external_urls", {}).get("spotify", "N/A")
                        results[artist["id"]] = (name, url)
                        c.execute('INSERT OR REPLACE INTO artist_cache (id, name, url) VALUES (?, ?, ?)', (artist["id"], name, url))
            else:
                logging.warning(f"Failed to fetch artists: {r.status_code}")
        cache_conn.commit()
    results.update(cached)
    return results

def batch_get_tracks(track_ids, token, cache_conn):
    """Fetch track names and URLs in batches, with caching."""
    c = cache_conn.cursor()
    c.execute('CREATE TABLE IF NOT EXISTS track_cache (id TEXT PRIMARY KEY, name TEXT, url TEXT)')
    c.execute('SELECT id, name, url FROM track_cache WHERE id IN ({})'.format(','.join('?' * len(track_ids))), track_ids)
    cached = {row[0]: (row[1], row[2]) for row in c.fetchall()}
    
    to_fetch = [tid for tid in track_ids if tid not in cached]
    results = {}
    if to_fetch:
        for i in range(0, len(to_fetch), 50):
            batch = to_fetch[i:i+50]
            url = f"https://api.spotify.com/v1/tracks?ids={','.join(batch)}"
            headers = {"Authorization": f"Bearer {token}"}
            r = requests.get(url, headers=headers)
            if r.status_code == 200:
                for track in r.json().get("tracks", []):
                    if track:
                        name = track.get("name")
                        url = track.get("external_urls", {}).get("spotify", "N/A")
                        results[track["id"]] = (name, url)
                        c.execute('INSERT OR REPLACE INTO track_cache (id, name, url) VALUES (?, ?, ?)', (track["id"], name, url))
            else:
                logging.warning(f"Failed to fetch tracks: {r.status_code}")
        cache_conn.commit()
    results.update(cached)
    return results

def enrich_metadata(df):
    """Enrich dataframe with artist and song metadata from Spotify."""
    token = get_spotify_token()
    cache_conn = sqlite3.connect(CACHE_DB)
    
    artist_ids = df['spotify_artist_id'].dropna().unique().tolist()
    track_ids = df['spotify_song_id'].dropna().unique().tolist()
    
    artists = batch_get_artists(artist_ids, token, cache_conn)
    tracks = batch_get_tracks(track_ids, token, cache_conn)
    
    df['artist_name'] = df['spotify_artist_id'].map(lambda x: artists.get(x, (None, 'N/A'))[0] if pd.notna(x) else 'unknown')
    df['artist_url'] = df['spotify_artist_id'].map(lambda x: artists.get(x, (None, 'N/A'))[1] if pd.notna(x) else 'N/A')
    df['song_name'] = df['spotify_song_id'].map(lambda x: tracks.get(x, (None, 'N/A'))[0] if pd.notna(x) else 'unknown')
    df['song_url'] = df['spotify_song_id'].map(lambda x: tracks.get(x, (None, 'N/A'))[1] if pd.notna(x) else 'N/A')
    
    cache_conn.close()
    return df

def parse_chord(chord_str):
    """Parse a chord string into root, quality, and bass note."""
    match = re.match(r'([A-G][b#]?)(m|maj|dim|aug|sus)?(\d+)?(/([A-G][b#]?))?', chord_str)
    if not match:
        return None
    root, quality, extension, _, bass = match.groups()
    quality = {'m': 'minor', 'maj': 'major', 'dim': 'diminished', 'aug': 'augmented', 'sus': 'suspended'}.get(quality, 'major')
    if extension:
        quality += extension
    return {'root': root, 'quality': quality, 'bass': bass}

def get_diatonic_chords(key):
    """Return diatonic chord roots for a given key."""
    key_idx = NOTE_TO_INDEX[key]
    return [CHROMATIC_NOTES[(key_idx + degree) % 12] for degree in MAJOR_DIATONIC_DEGREES]

def score_key(chords, key):
    """Score how well a key fits a chord progression."""
    diatonic_chords = get_diatonic_chords(key)
    score = 0
    for chord in chords:
        parsed = parse_chord(chord)
        if parsed and parsed['root'] in diatonic_chords:
            score += 1
            if parsed['root'] == key:
                score += 2  # Extra weight for tonic
            elif parsed['root'] == CHROMATIC_NOTES[(NOTE_TO_INDEX[key] + 7) % 12]:
                score += 1.5  # Extra weight for dominant
    return score

def detect_key(chords):
    """Detect the most likely key of a chord progression."""
    possible_keys = CHROMATIC_NOTES
    scores = {key: score_key(chords, key) for key in possibleKeys}
    best_key = max(scores, key=scores.get)
    return best_key

def assign_roman_numeral(progression, idx, key):
    """Assign a Roman numeral to a chord based on key and context."""
    chord = progression[idx]
    parsed = parse_chord(chord)
    if not parsed:
        return '?'
    root = parsed['root']
    quality = parsed['quality']
    bass = parsed['bass']
    degree = (NOTE_TO_INDEX[root] - NOTE_TO_INDEX[key]) % 12
    roman_dict = {0: 'I', 2: 'ii', 4: 'iii', 5: 'IV', 7: 'V', 9: 'vi', 11: 'vii°'}
    
    # Check if diatonic
    if degree in roman_dict:
        roman_base = roman_dict[degree]
    else:
        # Handle non-diatonic chords (e.g., secondary dominants)
        if quality.startswith('major') and idx + 1 < len(progression):
            next_chord = parse_chord(progression[idx + 1])
            if next_chord:
                next_degree = (NOTE_TO_INDEX[next_chord['root']] - NOTE_TO_INDEX[key]) % 12
                if next_degree in roman_dict and (NOTE_TO_INDEX[root] - NOTE_TO_INDEX[next_chord['root']]) % 12 == 7:
                    roman_base = f'V{"7" if "7" in quality else ""}/{roman_dict[next_degree]}'
                else:
                    roman_base = f'#{degree+1}' if degree > 6 else f'b{degree+1}'
        else:
            roman_base = f'#{degree+1}' if degree > 6 else f'b{degree+1}'
    
    # Adjust for quality
    if quality == 'minor' and not roman_base.startswith('V'):
        roman_base = roman_base.lower()
    elif quality == 'diminished':
        roman_base += '°'
    elif '7' in quality and not roman_base.startswith('V'):
        roman_base += '7'
    
    # Handle inversions
    if bass and bass != root:
        bass_degree = (NOTE_TO_INDEX[bass] - NOTE_TO_INDEX[key]) % 12
        roman_base += f'/{["6","64","43","42"][[0,2,4,7].index(bass_degree) % 4] if bass_degree in [0,2,4,7] else bass_degree+1}'
    
    return roman_base

def process_progression(progression_str, key):
    """Convert a chord progression string to Roman numerals, preserving section markers."""
    parts = re.split(r'(<[^>]+>)', progression_str)
    roman_progression = []
    chords = [part.split() for part in parts if not part.startswith('<') and part.strip()]
    flat_chords = [chord for sublist in chords for chord in sublist]
    for part in parts:
        if part.startswith('<'):
            roman_progression.append(part)
        else:
            for idx, chord in enumerate(part.split()):
                global_idx = flat_chords.index(chord, sum(len(p.split()) for p in parts[:parts.index(part)] if not p.startswith('<')))
                roman = assign_roman_numeral(flat_chords, global_idx, key)
                roman_progression.append(roman)
    return ' '.join(roman_progression)

def main(input_path, output_path):
    """Main function to enrich dataset and perform harmonic analysis."""
    logging.info("Starting dataset enrichment and harmonic analysis...")
    df = pd.read_csv(input_path)
    df = enrich_metadata(df)
    
    for idx, row in df.iterrows():
        chords = row['chords']
        if pd.isna(chords):
            df.at[idx, 'key'] = 'unknown'
            df.at[idx, 'roman_numerals'] = 'no_harmony'
            continue
        chord_list = [chord for part in re.split(r'<[^>]+>', chords) for chord in part.split() if chord]
        key = detect_key(chord_list)
        df.at[idx, 'key'] = key
        df.at[idx, 'roman_numerals'] = process_progression(chords, key)
        logging.info(f"Processed song {idx+1}: Key={key}, Roman={df.at[idx, 'roman_numerals'][:50]}...")
    
    df.to_csv(output_path, index=False)
    logging.info(f"Enriched dataset saved to {output_path}")

