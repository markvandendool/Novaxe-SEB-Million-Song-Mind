    async def batch_fetch(self,ids:List[str],endpoint:str) -> Dict[str,Dict]:
        # check Redis, fallback DB, then AIOHTTP
        out,cached={},{}
        for id_ in ids:
            key=f"{endpoint}_{id_}"
            if self.db.redis:
                d=self.db.redis.get(key)
                if d: cached[id_]=json.loads(d); continue
            # else check DB omitted for brevity
            # ...
        out.update(cached)
        tof=[i for i in ids if i not in cached]
        headers={"Authorization":f"Bearer {self._get_token()}"}
        async with aiohttp.ClientSession(headers=headers) as sess:
            for i in range(0,len(tof),self.cfg.batch_size):
                batch=tof[i:i+self.cfg.batch_size]
                url=f"https://api.spotify.com/v1/{endpoint}?ids={','.join(batch)}"
                async with sess.get(url,timeout=self.cfg.api_timeout) as resp:
                    data=await resp.json(); items=data.get(endpoint,[])
                    for it in items:
                        md={"name":it.get("name"),"url":it["external_urls"]["spotify"]}
                        out[it["id"]]=md
                        if self.db.redis: self.db.redis.setex(f"{endpoint}_{it['id']}",86400,json.dumps(md))
        return out

