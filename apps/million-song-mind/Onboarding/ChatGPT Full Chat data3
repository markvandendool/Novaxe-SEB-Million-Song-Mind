    return 'V'  # Common dominant fallback

def process_progression(chords, key, is_major):
    """Convert chord progression to Roman numerals with section awareness."""
    parts = re.split(r'(<[^>]+>)', chords)
    roman_progression = []
    flat_chords = [c for part in [p.split() for p in parts if not p.startswith('<') and p.strip()] for c in part]
    for part in parts:
        if part.startswith('<'):
            roman_progression.append(part)
        else:
            for idx, chord in enumerate(part.split()):
                global_idx = sum(len(p.split()) for p in parts[:parts.index(part)] if not p.startswith('<')) + idx
                roman = assign_roman_numeral(chord, key, is_major, flat_chords, global_idx)
                roman_progression.append(roman)
    return ' '.join(roman_progression)

def align_with_audio(chords, audio_url):
    """Align chords with beat/downbeat using Omnizart (if audio available)."""
    if not audio_url or 'preview' not in audio_url:
        return chords
    app = music.MusicApp(application='chord')
    transcription = app.transcribe(audio_url)
    if not transcription or 'chords' not in transcription:
        return chords
    audio_chords = transcription['chords']
    text_chords = re.findall(r'[A-G][b#]?[m|maj|dim|aug|sus]?\d*(?:/[A-G][b#]?)?', chords.lower())
    aligned = []
    for ac in audio_chords:
        timestamp, ac_chord = ac['time'], ac['chord'].upper()
        if any(tc.lower() in ac_chord.lower() for tc in text_chords):
            aligned.append((timestamp, ac_chord))
    return ' '.join(f"{c}@{t:.2f}" for t, c in aligned)

