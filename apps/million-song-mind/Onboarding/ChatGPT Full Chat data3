import csv, re
from collections import Counter
from statistics import mode

EXTENSIONS = ["b7","7","sus4","sus2","9","b9","#9","11","#11","13","b13","alt","no3","no5","6","b2","bb3","#4","b6","bb7"]

def parse_chord_symbol(symbol):
    v=[0]*(5+len(EXTENSIONS));v[0:5]=[1,1,0,0,0]
    s=symbol.lower(); im=[]
    if "maj7" in s: im+=["7"]
    elif re.search(r"7(?!sus|\d)",s): im+=["b7"]
    if "9" in s: im+=["9"]
    if "13" in s: im+=["13"]
    if "sus4" in s: im+=["sus4"]
    if "sus2" in s: im+=["sus2"]
    if "alt" in s: im+=["alt"]
    if "no3" in s: im+=["no3"]
    if "no5" in s: im+=["no5"]
    if re.search(r"[^m]6",s): im+=["6"]
    for ext in set(im):
        if ext in EXTENSIONS: v[5+EXTENSIONS.index(ext)]=1
    while v and v[-1]==0: v.pop()
    return ",".join(map(str,v))

NOTE_ORDER=['C','C#','D','D#','E','F','F#','G','G#','A','A#','B']
def normalize_root(c):
    m=re.match(r'^([A-G][b#]?)(?:m|maj|min|dim|sus|\d|\W)',c)
    return m[1] if m else None

def detect_key(chords):
    roots=[normalize_root(c) for c in chords if normalize_root(c)]
    if not roots: return "Unknown"
    return mode(roots) if len(roots)>1 else roots[0]

def roman(c,key):
    try:
        ki=NOTE_ORDER.index(key)
        cr=normalize_root(c)
        if not cr: return "?"
        ci=NOTE_ORDER.index(cr)
        return {0:'I',2:'ii',4:'iii',5:'IV',7:'V',9:'vi',11:'vii°'}[(ci-ki)%12]
    except: return "?"

def enrich_row(row):
    # ← non-destructive filter for section tags
    raw=row.get("chords","").split()
    chords=[c for c in raw if not (c.startswith("<") and c.endswith(">"))]
    try:
        k=detect_key(chords)
        rn=" - ".join(roman(c,k) for c in chords)
        fp=" | ".join(parse_chord_symbol(c) for c in chords)
        row["key"]=k; row["roman_numerals"]=rn; row["harmonic_fingerprint"]=fp
    except Exception:
        row["key"]=row["roman_numerals"]=row["harmonic_fingerprint"]="ERROR"
    return row

def enrich_csv(inp,outp):
    with open(inp,encoding='utf-8',newline='') as f_in, \
         open(outp,'w',encoding='utf-8',newline='') as f_out:
        rd=csv.DictReader(f_in)
        fn=rd.fieldnames+["key","roman_numerals","harmonic_fingerprint"]
        wr=csv.DictWriter(f_out,fieldnames=fn)
        wr.writeheader()
        for r in rd: wr.writerow(enrich_row(r))

if __name__=="__main__":
    enrich_csv("CPML Real Names.csv","data3.csv")
