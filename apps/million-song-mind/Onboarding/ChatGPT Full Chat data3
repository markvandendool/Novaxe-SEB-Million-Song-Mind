import csv
import re
from collections import Counter
from statistics import mode

EXTENSIONS = ["b7", "7", "sus4", "sus2", "9", "b9", "#9", "11", "#11", "13", "b13", "alt", "no3", "no5", "6", "b2", "bb3", "#4", "b6", "bb7"]

def parse_chord_symbol(symbol):
    vector = [0] * (5 + len(EXTENSIONS))
    vector[0:5] = [1, 1, 0, 0, 0]
    symbol = symbol.lower()
    implied = []
    if "maj7" in symbol: implied += ["7"]
    elif "7" in symbol: implied += ["b7"]
    if "9" in symbol: implied += ["9"]
    if "13" in symbol: implied += ["13"]
    if "sus4" in symbol: implied += ["sus4"]
    if "sus2" in symbol: implied += ["sus2"]
    if "alt" in symbol: implied += ["alt"]
    if "no3" in symbol: implied += ["no3"]
    if "no5" in symbol: implied += ["no5"]
    if "6" in symbol: implied += ["6"]
    for ext in set(implied):
        if ext in EXTENSIONS:
            idx = EXTENSIONS.index(ext)
            vector[5 + idx] = 1
    while vector and vector[-1] == 0:
        vector.pop()
    return ",".join(map(str, vector))

NOTE_ORDER_SHARP = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B']
ROMAN_NUMERALS = ['I', 'ii', 'iii', 'IV', 'V', 'vi', 'vii°']

def normalize_chord_root(chord):
    match = re.match(r'^([A-G][b#]?)(m|maj|min|dim|sus|7|add|\(|$)', chord)
    return match.group(1) if match else None

def detect_key(chords):
    roots = [normalize_chord_root(c) for c in chords if normalize_chord_root(c)]
    if not roots: return "Unknown"
    root_counts = Counter(roots)
    try:
        return mode(roots)
    except:
        return roots[0]

def get_roman_numeral(chord, key):
    try:
        key_index = NOTE_ORDER_SHARP.index(key)
        chord_root = normalize_chord_root(chord)
        if not chord_root: return "?"
        chord_index = NOTE_ORDER_SHARP.index(chord_root)
        interval = (chord_index - key_index) % 12
        return {
            0: 'I', 2: 'ii', 4: 'iii', 5: 'IV',
            7: 'V', 9: 'vi', 11: 'vii°'
        }.get(interval, '?')
    except:
        return "?"

def enrich_row(row):
    try:
        chords = row.get("chords", "").split()
        key = detect_key(chords)
        roman_numerals = " - ".join(get_roman_numeral(c, key) for c in chords)
        fingerprint = " | ".join(parse_chord_symbol(c) for c in chords)
        row["key"] = key
        row["roman_numerals"] = roman_numerals
        row["harmonic_fingerprint"] = fingerprint
        return row
    except Exception as e:
        row["key"] = "ERROR"
        row["roman_numerals"] = "ERROR"
        row["harmonic_fingerprint"] = "ERROR"
        return row

def enrich_csv(input_path, output_path):
    with open(input_path, newline='', encoding='utf-8') as f_in, \
         open(output_path, "w", newline='', encoding='utf-8') as f_out:
        reader = csv.DictReader(f_in)
        fieldnames = reader.fieldnames + ["key", "roman_numerals", "harmonic_fingerprint"]
        writer = csv.DictWriter(f_out, fieldnames=fieldnames)
        writer.writeheader()
        for row in reader:
            enriched = enrich_row(row)
            writer.writerow(enriched)

if __name__ == "__main__":
