    genre = df.at[idx, 'genre'] if 'df' in locals() and idx is not None else 'pop'
    progressions = COMMON_PROGRESSIONS.get(genre, COMMON_PROGRESSIONS['pop'])
    for prog in progressions:
        prog_chords = prog.split('-')
        for i, chord in enumerate(prog_chords):
