    elif quality == 'major' and not is_major and not roman_base.startswith('V'):
        roman_base = roman_base.upper()
    elif quality == 'diminished':
        roman_base += '°'
    elif '7' in quality:
        roman_base += '7'
    elif '9' in quality:
        roman_base += '9'
    elif quality == 'augmented':
        roman_base += '+'
    
    # Inversion handling
    if bass and bass != root:
        bass_degree = (NOTE_TO_INDEX[bass] - NOTE_TO_INDEX[key]) % 12
        intervals = [4, 7, 10, 11] if '7' in quality else [4, 7]
