# enrich_spotify_ids.py

import csv
import requests
import base64
import time

# ✅ Corrected Spotify credentials
CLIENT_ID = "fe078534288e4a8f95c41a189e9cc493"
CLIENT_SECRET = "26dcec68d1bc4ad3b2e9c72709da77cc"

def get_spotify_token():
    auth_str = f"{CLIENT_ID}:{CLIENT_SECRET}"
    b64_auth = base64.b64encode(auth_str.encode()).decode()
    headers = {"Authorization": f"Basic {b64_auth}"}
    data = {"grant_type": "client_credentials"}

    r = requests.post("https://accounts.spotify.com/api/token", data=data, headers=headers)
    r.raise_for_status()
    return r.json()["access_token"]

def get_artist_name(artist_id, headers):
    url = f"https://api.spotify.com/v1/artists/{artist_id}"
    resp = requests.get(url, headers=headers)
    if resp.status_code == 200:
        data = resp.json()
        return data.get("name"), data.get("external_urls", {}).get("spotify")
    return None, None

def get_track_info(track_id, headers):
    url = f"https://api.spotify.com/v1/tracks/{track_id}"
    resp = requests.get(url, headers=headers)
    if resp.status_code == 200:
        data = resp.json()
        return data.get("name"), data.get("external_urls", {}).get("spotify")
    return None, None

def enrich_csv(input_path, output_path):
    token = get_spotify_token()
    headers = {"Authorization": f"Bearer {token}"}

    with open(input_path, newline='', encoding='utf-8') as f_in, \
         open(output_path, 'w', newline='', encoding='utf-8') as f_out:

        reader = csv.DictReader(f_in)
        fieldnames = reader.fieldnames + ["artist_name", "artist_url", "song_name", "song_url"]
        writer = csv.DictWriter(f_out, fieldnames=fieldnames)
        writer.writeheader()

        for row in reader:
            artist_id = row.get("spotify_artist_id", "").strip()
            song_id = row.get("spotify_song_id", "").strip()

            artist_name, artist_url = get_artist_name(artist_id, headers)
            song_name, song_url = get_track_info(song_id, headers)

            row["artist_name"] = artist_name or ""
            row["artist_url"] = artist_url or ""
            row["song_name"] = song_name or ""
            row["song_url"] = song_url or ""

            writer.writerow(row)
            time.sleep(0.2)  # avoid rate limits

if __name__ == "__main__":
    enrich_csv("cpml_snippet.csv", "data2.5.csv")
