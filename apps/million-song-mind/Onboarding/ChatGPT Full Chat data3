# DISTRIBUTED PROCESSOR
# =============================================================================

if RAY:
    @ray.remote
    class Processor:
        def __init__(self,cfg):
            self.mte=MusicTheoryEngine(); self.kd=MLKeyDetector()
        def analyze(self,song:Dict)->Dict:
            chords=song.get("chords","").split()
            if not chords: return {"id":song["id"],"roman_numerals":"no_harmony"}
            parsed=[self.mte.parse_chord(c) for c in chords if self.mte.parse_chord(c)]
            key,is_maj,conf=self.kd.detect(chords)
            romans=[]
            for p in parsed:
                deg=(MusicTheoryEngine.IDX[p["root"]]-MusicTheoryEngine.IDX[key])%12
                base=(MusicTheoryEngine.MAJ if is_maj else MusicTheoryEngine.MIN)[deg] if deg in (MusicTheoryEngine.MAJ if is_maj else MusicTheoryEngine.MIN) else f"#{deg}"
                if "dim" in p["quality"]: base+="°"
                elif "aug" in p["quality"]: base+="+"
                elif any(x in p["quality"] for x in ["7","9","11","13"]): base+="7"
                romans.append(base)
            vl=self.mte.analyze_voice_leading(parsed)
            return {
              "id":song["id"],"detected_key":key,"is_major":is_maj,
              "key_confidence":conf,"roman_numerals":" ".join(romans),
              "smoothness":vl["smoothness"],"parallel":vl["parallel"],
              "contrary":vl["contrary"],
              "complexity":len(set(chords))/len(chords),
              "processed_at":time.time()
            }

# =============================================================================
# MAIN PIPELINE
# =============================================================================

async def main():
    # CLI & config
    p=argparse.ArgumentParser(); p.add_argument("-c","--config"); p.add_argument("-i","--input",required=True)
    p.add_argument("-o","--output",default="enriched.csv"); args=p.parse_args()
    cfg = Config.from_yaml(args.config) if args.config else Config()
    db=DBManager(cfg); sp=SpotifyClient(cfg,db)

    # Load & enrich
    df=pl.read_csv(args.input)
    artists,tracks=await asyncio.gather(
        sp.batch_fetch(df["spotify_artist_id"].drop_nulls().unique().to_list(),"artists"),
        sp.batch_fetch(df["spotify_song_id"].drop_nulls().unique().to_list(),"tracks")
    )
    df=df.with_columns([
       pl.col("spotify_artist_id").map_dict({k:v["name"] for k,v in artists.items()},"Unknown").alias("artist_name"),
       pl.col("spotify_song_id").map_dict({k:v["name"] for k,v in tracks.items()},"Unknown").alias("song_name")
    ])

    # Distribute analysis
    records=df.to_dicts()
    if RAY:
        proc=[Processor.remote(cfg) for _ in range(cfg.max_workers)]
        chunks=[records[i:i+cfg.chunk_size] for i in range(0,len(records),cfg.chunk_size)]
        futures=[proc[i%len(proc)].analyze.remote(ch) for i,ch in enumerate(chunks)]
        results=[]
        for fut in futures: results+=ray.get(fut)
    else:
        executor=ThreadPoolExecutor(cfg.max_workers)
        loop=asyncio.get_event_loop()
        tasks=[loop.run_in_executor(executor, Processor(cfg).analyze, r) for r in records]
        results=await asyncio.gather(*tasks)

    # Save & insert
    out=pl.DataFrame(results)
    combined=df.join(out,on="id")
    combined.write_csv(args.output)
    db.bulk_insert(results)
    if RAY: ray.shutdown()

if __name__=="__main__":
    logging.basicConfig(level=logging.INFO)
