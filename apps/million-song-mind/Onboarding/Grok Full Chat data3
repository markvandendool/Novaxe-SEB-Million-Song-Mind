CACHE_DB        = "spotify_cache.db"
CHROMATIC_NOTES = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B']
NOTE_TO_INDEX   = {n:i for i,n in enumerate(CHROMATIC_NOTES)}
MAJOR_DIATONIC  = {0:'I',2:'ii',4:'iii',5:'IV',7:'V',9:'vi',11:'vii°'}
MINOR_DIATONIC  = {0:'i',2:'ii°',3:'III',5:'iv',7:'v',8:'VI',10:'VII'}
COMMON_PROGRESSIONS = {
    'pop':    ['I-IV-V-I','I-vi-IV-V','ii-V-I','I-V-vi-IV'],
    'jazz':   ['ii-V-I','I-vi-ii-V','iii-vi-ii-V'],
    'rock':   ['I-IV-V','I-bVII-IV'],
    'country':['I-IV-V-I','I-ii-IV-V']
}

logging.basicConfig(level=logging.INFO, format='%(asctime)s %(levelname)s %(message)s')

# ─── Spotify Helpers ───────────────────────────────────────────────────────────
def get_spotify_token():
    creds   = f"{CLIENT_ID}:{CLIENT_SECRET}"
    encoded = base64.b64encode(creds.encode()).decode()
    r = requests.post("https://accounts.spotify.com/api/token",
                      headers={"Authorization":f"Basic {encoded}"},
                      data={"grant_type":"client_credentials"})
    r.raise_for_status()
    return r.json()["access_token"]

def batch_fetch(ids, token, table, endpoint):
    """Generic batch-fetch + SQLite cache."""
    conn = sqlite3.connect(CACHE_DB)
    c    = conn.cursor()
    c.execute(f"CREATE TABLE IF NOT EXISTS {table} (id TEXT PRIMARY KEY, name TEXT, url TEXT)")
    placeholders = ",".join("?"*len(ids))
    c.execute(f"SELECT id,name,url FROM {table} WHERE id IN ({placeholders})", ids)
    cached = {row[0]:(row[1],row[2]) for row in c.fetchall()}
    to_fetch = [i for i in ids if i not in cached]
    results  = {}
    for i in range(0, len(to_fetch), 50):
        batch = to_fetch[i:i+50]
        url   = f"https://api.spotify.com/v1/{endpoint}?ids={','.join(batch)}"
        res   = requests.get(url, headers={"Authorization":f"Bearer {token}"})
        if res.status_code==200:
            for item in res.json().get(endpoint.split('?')[0], []):
                name = item.get("name")
                u    = item.get("external_urls",{}).get("spotify","N/A")
                results[item["id"]] = (name,u)
                c.execute(f"INSERT OR REPLACE INTO {table} VALUES(?,?,?)",(item["id"],name,u))
        else:
            logging.warning(f"Failed fetch {endpoint}: {res.status_code}")
    conn.commit()
    conn.close()
    results.update(cached)
    return results

def enrich_metadata(df):
    token       = get_spotify_token()
    artist_ids  = df['spotify_artist_id'].dropna().unique().tolist()
    track_ids   = df['spotify_song_id'].dropna().unique().tolist()
    artists     = batch_fetch(artist_ids, token, "artist_cache", "artists")
    tracks      = batch_fetch(track_ids,  token, "track_cache",  "tracks")
    df['artist_name']   = df['spotify_artist_id'].map(lambda x: artists.get(x,(None,'N/A'))[0] if pd.notna(x) else 'unknown')
    df['artist_url']    = df['spotify_artist_id'].map(lambda x: artists.get(x,(None,'N/A'))[1] if pd.notna(x) else 'N/A')
    df['song_name']     = df['spotify_song_id'].map(lambda x: tracks.get(x,(None,'N/A'))[0] if pd.notna(x) else 'unknown')
    df['song_url']      = df['spotify_song_id'].map(lambda x: tracks.get(x,(None,'N/A'))[1] if pd.notna(x) else 'N/A')
    df['missing_metadata']=~(df['artist_name'].ne('unknown') & df['song_name'].ne('unknown'))
    return df

# ─── Chord Parsing & Key Detection ─────────────────────────────────────────────
def parse_chord(chord_str):
    m = re.match(r'([A-G][b#]?)(m|maj|dim|aug|sus)?(\d+)?(/([A-G][b#]?))?', chord_str)
    if not m: return None
    root,quality,ext,_,bass = m.groups()
    qmap = {'m':'minor','maj':'major','dim':'diminished','aug':'augmented','sus':'suspended'}
    quality = qmap.get(quality,'major')
    if ext: quality+=ext
    return {'root':root.replace('b','#'),'quality':quality,'bass':bass}

def detect_key(chords, row, idx):
    chord_list = [c for part in re.split(r'<[^>]+>', chords) for c in part.split() if c]
    key_scores  = {k:0 for k in CHROMATIC_NOTES}
    for i,ch in enumerate(chord_list):
        p = parse_chord(ch)
        if not p: continue
        ridx = NOTE_TO_INDEX[p['root']]
        for key in CHROMATIC_NOTES:
            kidx  = NOTE_TO_INDEX[key]
            deg   = (ridx-kidx)%12
            if deg in MAJOR_DIATONIC or (deg-3)%12 in MINOR_DIATONIC:
                w = 2.0 if deg%7 in [0,4] else 1.5 if deg%7==3 else 1.0
                key_scores[key]+=w
            # modal mixture + motivic resolution
            shift = 3 if deg not in MINOR_DIATONIC else -3
            pkey  = CHROMATIC_NOTES[(kidx+shift)%12]
            pdeg  = (deg-shift)%12
            if pdeg in (MINOR_DIATONIC if deg not in MINOR_DIATONIC else MAJOR_DIATONIC):
                if i+1<len(chord_list):
                    npd = parse_chord(chord_list[i+1])
                    if npd and NOTE_TO_INDEX[npd['root']] - kidx in [5,7]:
                        key_scores[pkey]+=1.0
                    else:
                        key_scores[pkey]+=0.5
    best   = max(key_scores, key=key_scores.get)
    total  = sum(key_scores.values()) or 1
    is_maj = key_scores[best] > total/len(CHROMATIC_NOTES)
    # ambiguity via Bayesian smoothing
    df.at[idx,'ambiguous_key'] = abs(max(key_scores.values())-min(key_scores.values()))<0.5
    # tension score
    df.at[idx,'modal_tension_score'] = 1.0 - (key_scores[best]/total)
    df.at[idx,'detected_key']=best
    df.at[idx,'is_major']    = is_maj
    return best,is_maj,key_scores

# ─── Roman Numeral Assignment ────────────────────────────────────────────────
def infer_roman_from_context(prog, idx, key, is_maj, row):
    window = min(5,len(prog)-idx)
    ctx    = prog[max(0,idx-2):idx+window]
    parsed = [parse_chord(c) for c in ctx if parse_chord(c)]
    if not parsed or idx>=len(prog):
        return 'I'
    genre = row.get('genre','pop')
    for pattern in COMMON_PROGRESSIONS.get(genre,COMMON_PROGRESSIONS['pop']):
        seq = pattern.split('-')
        for i,ch in enumerate(seq):
            if i<len(parsed)-1 and parsed[i]['root']:
                pdg = (NOTE_TO_INDEX[parsed[i]['root']]-NOTE_TO_INDEX[key])%12
                if pdg in (MAJOR_DIATONIC if is_maj else MINOR_DIATONIC):
                    if i+1==idx-max(0,idx-2):
                        nxt = seq[i+1]
                        return nxt.lower() if nxt.isupper() and not is_maj else nxt
    return 'V'

def assign_roman(chord, key, is_maj, prog, idx):
    p = parse_chord(chord)
    if not p:
        return infer_roman_from_context(prog,idx,key,is_maj,row)
    root,qual,bass = p['root'],p['quality'],p['bass']
    deg = (NOTE_TO_INDEX[root]-NOTE_TO_INDEX[key])%12
    rd  = MAJOR_DIATONIC if is_maj else MINOR_DIATONIC
    if deg in rd:
        base = rd[deg]
    else:
        # modal mixture / secondary dominant
        par = CHROMATIC_NOTES[(NOTE_TO_INDEX[key]+(3 if is_maj else -3))%12]
