def parse_chord(chord_str):
    """Parse chord into root, quality, extension, and bass."""
    match = re.match(r'([A-G][b#]?)(m|maj|dim|aug|sus)?(\d+)?(/([A-G][b#]?))?', chord_str)
    if not match:
        return None
    root, quality, ext, _, bass = match.groups()
    quality_map = {'m': 'minor', 'maj': 'major', 'dim': 'diminished', 'aug': 'augmented', 'sus': 'suspended'}
    quality = quality_map.get(quality, 'major')
    if ext:
        quality += ext
    return {'root': root.replace('b', '#'), 'quality': quality, 'bass': bass}

