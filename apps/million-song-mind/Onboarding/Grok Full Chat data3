            base = (MINOR_DIATONIC if is_maj else MAJOR_DIATONIC)[pdeg]
            base = base.lower() if is_maj else base.upper()
        elif idx+1<len(prog):
            nxt = parse_chord(prog[idx+1])
            if nxt and (NOTE_TO_INDEX[nxt['root']]-NOTE_TO_INDEX[root])%12==7:
                nd=(NOTE_TO_INDEX[nxt['root']]-NOTE_TO_INDEX[key])%12
                if nd in rd:
                    base=f'V{"7" in qual and "7" or ""}/{rd[nd]}'
                else:
                    base = f'b{((deg-1)%12)+1}' if deg>6 else f'#{deg+1}'
            else:
                base = f'b{((deg-1)%12)+1}' if deg>6 else f'#{deg+1}'
        else:
            base = f'b{((deg-1)%12)+1}' if deg>6 else f'#{deg+1}'
    # quality + inversion
    if qual.startswith('minor') and is_maj and not base.startswith('V'): base=base.lower()
    elif qual.startswith('major') and not is_maj and not base.startswith('V'): base=base.upper()
    elif '°' in qual: base+='°'
    elif '7' in qual:    base+='7'
    elif '9' in qual:    base+='9'
    elif 'aug' in qual:  base+='+'
    # inversion
    if bass and bass!=root:
        bdeg=(NOTE_TO_INDEX[bass]-NOTE_TO_INDEX[key])%12
        ints=[4,7,10,11] if '7' in qual else [4,7]
        if bdeg in [(deg+i)%12 for i in ints]:
            idx2=ints.index((bdeg-deg)%12)
            invs=['6','64','43','42']
            names=['maj3','P5','min7','maj7']
            if idx2<len(invs):
                base+=invs[idx2]
                df.at[idx,'slash_inversion_type']=names[idx2]
            else:
                base+=f'/{bdeg+1}'
        else:
            logging.warning(f"Bass misalign {chord} in key {key}")
    return base

# ─── Audio Alignment ──────────────────────────────────────────────────────────
def align_with_audio(chords,aurl):
    if not aurl or 'preview' not in aurl: return chords
    try:
        app  = music.MusicApp(application='chord')
        tr   = app.transcribe(aurl)
        if tr and 'key' in tr:
            df.at[idx,'audio_key_confidence']='high'
            return ' '.join(f"{c['chord']}@{c['time']:.2f}" for c in tr['chords'])
        else:
            df.at[idx,'audio_key_confidence']='low'
    except Exception as e:
        logging.error(f"Audio failed: {e}")
        df.at[idx,'audio_key_confidence']='not_available'
    return chords

# ─── Main Pipeline ────────────────────────────────────────────────────────────
def main(inf="input.csv", outf="output.csv"):
    logging.info("BEGIN Enrichment")
    global df
    df = pd.read_csv(inf)
    df = enrich_metadata(df)
    for idx,row in df.iterrows():
        chords = row.get('chords','')
        if not isinstance(chords,str) or not chords.strip():
            df.at[idx,'roman_numerals']='no_harmony'
            df.at[idx,'aligned_roman'] ='no_harmony'
            continue
        key,is_maj,_ = detect_key(chords,row,idx)
        parts = re.split(r'(<[^>]+>)', chords)
        flat  = [c for seg in parts if not seg.startswith('<') for c in seg.split()]
        romans=[]
        for part in parts:
            if part.startswith('<'):
                romans.append(part)
            else:
                for i,ch in enumerate(part.split()):
                    gi = sum(len(s.split()) for s in parts[:parts.index(part)] if not s.startswith('<'))+i
                    romans.append(assign_roman(ch,key,is_maj,flat,gi))
        roman_str = ' '.join(romans)
        df.at[idx,'roman_numerals']   = roman_str
        df.at[idx,'aligned_roman']    = align_with_audio(roman_str,row['song_url'])
    df.to_csv(outf,index=False)
    logging.info("END Enrichment → Saved to %s", outf)

