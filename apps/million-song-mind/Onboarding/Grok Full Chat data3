    df['song_url']    = df['spotify_song_id'].map(lambda x: tracks.get(x,("", ""))[1] or "")
    df['missing_metadata'] = df['artist_name'].isna() | df['song_name'].isna()
    return df

# ─── CHORD PARSING & KEY DETECTION ─────────────────────────────────────────────
CHORD_RE = re.compile(r'([A-G][b#]?)(maj|min|m|dim|aug|sus|add)?(\d+)?([b#]\d+)?(?:/([A-G][b#]?))?')
def parse_chord(chord):
    m = CHORD_RE.match(chord)
    if not m: return None
    root, q, ext, alt, bass = m.groups()
    quality = {'m':'minor','min':'minor','maj':'major',
               'dim':'diminished','aug':'augmented',
               'sus':'suspended','add':'added'}.get(q,'major')
    if ext: quality += ext
    if alt: quality += alt
    return {'root':root.replace('b','#'), 'quality':quality, 'bass':bass}

def detect_key(chords, row_idx, df_row):
    sequence = [c for seg in re.split(r'<[^>]+>', chords) for c in seg.split() if c]
    scores   = {k:0.0 for k in CHROMATIC_NOTES}
    for i,ch in enumerate(sequence):
        p = parse_chord(ch)
        if not p: continue
        ridx = NOTE_TO_INDEX[p['root']]
        for key in CHROMATIC_NOTES:
            kidx = NOTE_TO_INDEX[key]
            deg  = (ridx-kidx)%12
            if deg in MAJOR_DIATONIC:
                scores[key] += 2.0 if deg==0 else 1.0
            elif (deg-3)%12 in MINOR_DIATONIC:
                scores[key] += 1.5 if (deg-3)%12==0 else 0.75
            # modal mixture
            shift = 3 if deg not in MINOR_DIATONIC else -3
            pkey  = CHROMATIC_NOTES[(kidx+shift)%12]
            pdeg  = (deg-shift)%12
            if pdeg in (MINOR_DIATONIC if deg not in MINOR_DIATONIC else MAJOR_DIATONIC):
                scores[pkey] += 0.5
    best   = max(scores, key=scores.get)
    total  = sum(scores.values()) or 1.0
    is_maj = scores[best] > (total/len(scores))
    df.at[row_idx,'detected_key'] = best
    df.at[row_idx,'is_major']    = is_maj
    df.at[row_idx,'ambiguous_key']= max(scores.values())-min(scores.values()) < 0.5
    df.at[row_idx,'tension_score']= 1.0 - (scores[best]/total)
    return best, is_maj

# ─── ROMAN NUMERAL ASSIGNMENT ─────────────────────────────────────────────────
def infer_roman_from_context(prog, idx, key, is_maj, genre):
    window = min(5, len(prog)-idx)
    ctx    = prog[max(0,idx-2):idx+window]
    parsed = [parse_chord(c) for c in ctx if parse_chord(c)]
    if not parsed or idx>=len(prog): return 'I'
    for pattern in COMMON_PROGRESSIONS.get(genre,'pop'):
        seq = pattern.split('-')
        for i,ch in enumerate(seq[:-1]):
            if i < len(parsed)-1 and parsed[i]['root']:
                deg = (NOTE_TO_INDEX[parsed[i]['root']] - NOTE_TO_INDEX[key])%12
                if deg in (MAJOR_DIATONIC if is_maj else MINOR_DIATONIC):
                    if i == idx-max(0,idx-2): return seq[i+1]
    return 'V'

def assign_roman(chord, key, is_maj, prog, idx, genre):
    p = parse_chord(chord)
    if not p: return infer_roman_from_context(prog, idx, key, is_maj, genre)
    root, qual, bass = p['root'], p['quality'], p['bass']
    deg = (NOTE_TO_INDEX[root]-NOTE_TO_INDEX[key])%12
    rd  = MAJOR_DIATONIC if is_maj else MINOR_DIATONIC
    if deg in rd:
        base = rd[deg]
    else:
        # secondary dominants / borrowed
        if idx+1<len(prog):
            nxt = parse_chord(prog[idx+1])
            if nxt and (NOTE_TO_INDEX[nxt['root']] - NOTE_TO_INDEX[root])%12==7:
                ng = (NOTE_TO_INDEX[nxt['root']]-NOTE_TO_INDEX[key])%12
                if ng in rd:
                    base = f'V7/{rd[ng]}'
                else:
                    base = f'b{deg+1}' if deg>6 else f'#{deg+1}'
            else:
                base = f'b{deg+1}' if deg>6 else f'#{deg+1}'
        else:
            base = f'b{deg+1}' if deg>6 else f'#{deg+1}'
    # quality & inversion
    if 'minor' in qual and is_maj: base = base.lower()
    if 'diminished' in qual: base += '°'
    if '7' in qual and 'V7' not in base: base += '7'
    if bass and bass!=root:
        bdeg = (NOTE_TO_INDEX[bass]-NOTE_TO_INDEX[key])%12
        ints = [4,7,10,11] if '7' in qual else [4,7]
        if bdeg in [(deg+i)%12 for i in ints]:
            inv = ['6','64','43','42'][ints.index((bdeg-deg)%12)]
            base += inv
    return base

# ─── OPTIONAL AUDIO ALIGNMENT ─────────────────────────────────────────────────
def align_with_audio(roman_seq, preview_url, row_idx):
    if not AUDIO_AVAILABLE or not preview_url: return roman_seq
    try:
        app = music.MusicApp(application='chord')
        tr  = app.transcribe(preview_url)
        if tr and 'chords' in tr:
            df.at[row_idx,'audio_confidence']='high'
            return ' '.join(f"{c['chord']}@{c['time']:.2f}" for c in tr['chords'])
    except Exception as e:
        logging.warning(f"Audio alignment error: {e}")
    df.at[row_idx,'audio_confidence']='low'
    return roman_seq

# ─── WORKER FOR MULTIPROCESSING ────────────────────────────────────────────────
def process_row(args):
    idx, row = args
    chords = row.get('chords','') or ''
    if not chords.strip():
        return idx, 'no_harmony', 'no_harmony'
    key, is_maj = detect_key(chords, idx, row)
    parts = re.split(r'(<[^>]+>)', chords)
    flat  = [c for seg in parts if not seg.startswith('<') for c in seg.split()]
    romans = []
    for part in parts:
        if part.startswith('<'):
            romans.append(part)
        else:
            for i,ch in enumerate(part.split()):
                gi = sum(len(s.split()) for s in parts[:parts.index(part)] if not s.startswith('<')) + i
                romans.append(assign_roman(ch, key, is_maj, flat, gi, row.get('genre','pop')))
    roman_seq = ' '.join(romans)
    aligned   = align_with_audio(roman_seq, row.get('song_url',''), idx)
    return idx, roman_seq, aligned

# ─── MAIN PIPELINE ────────────────────────────────────────────────────────────
if __name__ == "__main__":
    logging.info("▶️ Starting enrichment pipeline")
    df = pd.read_csv(INPUT_CSV)
    df = enrich_metadata(df)
    with Pool(cpu_count()) as pool:
        results = pool.map(process_row, df.iterrows())
    # Vectorized write
    idxs, romans, aligned = zip(*results)
    df.loc[idxs, 'roman_numerals'] = romans
    df.loc[idxs, 'aligned_roman']  = aligned
    df.to_csv(OUTPUT_CSV, index=False)
    logging.info(f"✅ Completed. Output saved to {OUTPUT_CSV}")
