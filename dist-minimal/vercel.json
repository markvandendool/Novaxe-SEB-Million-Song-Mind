{
    "version": 2,
    "buildCommand": "npm run build:deploy",
    "outputDirectory": "dist",
    "public": true,
    "alias": [
        "millionsongmind.com",
        "www.millionsongmind.com"
    ],
    "routes": [
        {
            "src": "/cubes/(.*)",
            "dest": "/cubes/$1"
        },
        {
            "src": "/cubes",
            "dest": "/cubes/index.html"
        },
        {
            "src": "/obsidian/(.*)",
            "dest": "/obsidian/$1"
        },
        {
            "src": "/obsidian",
            "dest": "/obsidian/index.html"
        },
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}