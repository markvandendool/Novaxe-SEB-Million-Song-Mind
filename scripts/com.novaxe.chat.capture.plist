<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.novaxe.chat.capture</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>node</string>
        <string>/Users/markvandendool/Novaxe-SEB-Million-Song-Mind/scripts/chat-logger.js</string>
    </array>
    <key>StartInterval</key>
    <integer>7200</integer> <!-- 2 hours = 7200 seconds -->
    <key>StandardOutPath</key>
    <string>/Users/markvandendool/Novaxe-SEB-Million-Song-Mind/logs/chat-capture-output.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/markvandendool/Novaxe-SEB-Million-Song-Mind/logs/chat-capture-error.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
