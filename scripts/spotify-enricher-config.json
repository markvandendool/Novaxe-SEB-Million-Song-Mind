{
    "spotify_api_base": "http://localhost:4200",
    "api_endpoints": {
        "search": "/api/spotify/songInfos",
        "features": "/api/spotify/songFeatures",
        "contents": "/api/spotify/songContents",
        "recommendations": "/api/spotify/songReco",
        "top_tracks": "/api/spotify/songTop"
    },
    "rate_limit": {
        "requests_per_second": 3,
        "batch_size": 50
    },
    "csv_settings": {
        "delimiter": ",",
        "quotechar": "\"",
        "encoding": "utf-8"
    },
    "logging": {
        "level": "INFO",
        "file": "spotify-enricher.log",
        "max_file_size_mb": 10
    },
    "cache_settings": {
        "enabled": true,
        "max_entries": 10000,
        "save_to_file": true,
        "cache_file": "spotify_cache_enricher.json"
    },
    "production": {
        "spotify_api_base": "https://app.novaxe.com",
        "api_endpoints": {
            "search": "/mysongsApi/spotify/songInfos.php",
            "features": "/mysongsApi/spotify/songFeatures.php",
            "contents": "/mysongsApi/spotify/songContents.php",
            "recommendations": "/mysongsApi/spotify/songReco.php",
            "top_tracks": "/mysongsApi/spotify/songTop.php"
        }
    }
}