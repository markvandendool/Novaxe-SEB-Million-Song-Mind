          this.yt.seekTo(pos);
        }else {
          let m = this.sel.select_next_measure();
          this.yt.seekTo(pos);
      case KEYS.M :
        this.addNextRegion();
      case KEYS.P :
        this.addNextPart();
      case KEYS.DELETE :
        let last_deleted_measure = this.sel.deleteSelection();
        this.resetAllRegionsFromModel();
