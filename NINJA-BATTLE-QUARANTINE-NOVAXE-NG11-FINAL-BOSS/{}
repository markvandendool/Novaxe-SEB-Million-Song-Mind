      },
      axisX:{
        valueFormatString: "DD MMM",
        crosshair: {
          enabled: true,
          snapToDataPoint: true
        }
      axisY: {
        title: "Score",
        includeZero: true,
          enabled: true
      toolTip:{
        shared:true
      },
      legend:{
        cursor:"pointer",
        verticalAlign: "bottom",
        horizontalAlign: "left",
        dockInsidePlotArea: true,
      data: [{
        type: "line",
        showInLegend: false,
        name: "Score",
        xValueFormatString: "DD MMM, YYYY",
        color: "#F08080",
        dataPoints: data
      ]
    }));
    return chart;
  } //create_chart
}

