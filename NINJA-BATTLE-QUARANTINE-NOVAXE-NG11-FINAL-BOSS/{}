  public validate(){
    this.stopChrono();
    let ans = {note:this.note+this.alteration, time:(this.endTime-this.startTime), index:this.curNoteIndex};
    if(this.parsedData == undefined: any) {
      debugger
      return;
    let hasWon_lh = true;
