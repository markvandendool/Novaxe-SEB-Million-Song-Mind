	  	}
	  	this.selected_fifth = this._fifths[(i+1)%12];
  	}else{
	  	let i = this._mfifths.indexOf(this.selected_mfifth);
		  	console.warn('fifth_circle next_mfifth() error : invalid selected mfifth')
	  	this.selected_mfifth = this._mfifths[(i+1)%12];
  	}
