        }, 20);
      case KEYS.SPACE :
        if(e.shiftKey: any) {
        if( this.ap.isPlaying() ){
         this.playPause();
        }else{
          let sel = this.sel.getSelection();
          if( sel[0].getType() == 'measure' ) this.ap.playMeasure(sel[0].getIdx());
          this.playPause();
